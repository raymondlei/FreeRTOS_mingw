{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build FreeRTOS MinGW simulation",
            "type": "shell",
            "command": "C:\\msys64\\ucrt64\\bin\\mingw32-make.exe",
            "args": [
                "-C",
                "${workspaceFolder}/WIN32-MingW"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build FreeRTOS MinGW blinky simulation",
            "type": "shell",
            "command": "C:\\msys64\\ucrt64\\bin\\mingw32-make.exe",
            "args": [
                "-C",
                "${workspaceFolder}/WIN32-MingW",
                "BLINKY_DEMO=1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        }
    ]
}
