        {
            "name": "Debug Example004",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build_functional/RTOSDemo.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/WIN32-MingW",
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
                }
            ],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe",
            "preLaunchTask": "Build Example004",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
