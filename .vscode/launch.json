{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug FreeRTOS MinGW simulation",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build_full/RTOSDemo.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/WIN32-MingW",
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
                }
            ],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe",
            "preLaunchTask": "Build FreeRTOS MinGW simulation",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug main_blinky FreeRTOS MinGW simulation",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build_blinky/RTOSDemo.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/WIN32-MingW",
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
                }
            ],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe",
            "preLaunchTask": "Build FreeRTOS MinGW blinky simulation",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
